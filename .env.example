# Local dev: postgres://postgres@localhost:5432/simplenepal
# Production: your Neon connection string (add ?sslmode=require)
DATABASE_URL=postgres://postgres@localhost:5432/simplenepal

# Protects /capture and /admin. Set something long and random.
ADMIN_PASSWORD=change-me-before-you-deploy

# Public site URL, used for canonical URLs and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000
